# What the program and the build scripts create (never source files)
/generated/
/dist/
__pycache__/
*.pyc

# Android app: the signing key (secret: with a different key Android refuses to update an installed app, so keep a
# copy somewhere safe), Gradle caches, local paths and the generated Python bundle
/packaging/android/keystore/
/packaging/android/**/*.jks
/packaging/android/**/*.keystore
/packaging/android/.gradle/
/packaging/android/build/
/packaging/android/app/build/
/packaging/android/local.properties
/packaging/android/app/src/main/assets/ytg-libs.zip

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
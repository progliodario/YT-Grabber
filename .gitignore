# folder created by the program: downloaded tools (ffmpeg, yt-dlp), settings, download list, cookies, logs, build files
generated/
__pycache__/
*.pyc

# build results (rebuilt with the scripts in the build-* folders)
/Windows/
/APK/

# Android app: signing key (secret: if you lose it you can no longer update the installed app, keep a copy)
build-apk/keystore/
build-apk/**/*.jks
build-apk/**/*.keystore

# Android app: Gradle caches, local paths and generated packages
build-apk/.gradle/
build-apk/app/build/
build-apk/build/
build-apk/local.properties
build-apk/app/src/main/assets/ytg-libs.zip

# Linux and macOS packages (rebuilt with build-linux\build-linux.bat and build-macos\build-macos.bat)
/Linux/
/macOS/
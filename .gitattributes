# Normalize line endings so the scripts work on every system
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.ico binary
*.jks binary
*.zip binary
*.apk binary
*.exe binary

# Launchers and package files must keep Unix line endings
build-linux/yt-grabber text eol=lf
build-linux/*.desktop text eol=lf
build-linux/*.yaml text eol=lf
build-macos/launcher text eol=lf
build-linux/yt-grabber.service text eol=lf
build-linux/appimage/AppRun text eol=lf
build-linux/appimage/*.desktop text eol=lf
build-linux/flatpak/yt-grabber text eol=lf
build-linux/flatpak/*.desktop text eol=lf
build-linux/flatpak/*.yml text eol=lf
build-linux/flatpak/*.xml text eol=lf

*.asc text eol=lf

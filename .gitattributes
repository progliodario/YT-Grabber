# Normalize line endings so the scripts work on every system
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.ico binary
*.jks binary
*.zip binary
*.apk binary
*.exe binary

# Launchers and package files must keep Unix line endings
build-linux/yt-grabber text eol=lf
build-linux/*.desktop text eol=lf
build-linux/*.yaml text eol=lf
build-macos/launcher text eol=lf

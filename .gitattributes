# Normalize line endings so the scripts work on every system
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.asc text eol=lf

# Binary files
*.png binary
*.ico binary
*.jks binary
*.zip binary
*.apk binary
*.exe binary

# Launchers and package files must keep Unix line endings (they run on Linux, macOS or Android)
packaging/linux/yt-grabber text eol=lf
packaging/linux/*.desktop text eol=lf
packaging/linux/*.yaml text eol=lf
packaging/linux/yt-grabber.service text eol=lf
packaging/linux/appimage/AppRun text eol=lf
packaging/linux/appimage/*.desktop text eol=lf
packaging/linux/flatpak/yt-grabber text eol=lf
packaging/linux/flatpak/*.desktop text eol=lf
packaging/linux/flatpak/*.yml text eol=lf
packaging/linux/flatpak/*.xml text eol=lf
packaging/macos/launcher text eol=lf
# https://editorconfig.org: the same basic settings in every editor. Line endings are handled by .gitattributes.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,webmanifest,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
charset = utf-8

[*.sh]
end_of_line = lf

[packaging/windows/version.txt]
charset = utf-8-bom
